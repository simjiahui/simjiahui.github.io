{
  "name": "moonlit-tides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --ignore-lock",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev --ignore-lock",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "cv": "node --import tsx scripts/generate-cv.ts",
    "build": "npm run cv && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-links.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --ignore-lock",
    "lint": "prettier --check \"src/**/*.{astro,ts,css}\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"*.mjs\"",
    "format": "prettier --write .",
    "test:browser": "ASTRO_TELEMETRY_DISABLED=1 node --import tsx scripts/browser-check.ts",
    "test:content-edit": "ASTRO_TELEMETRY_DISABLED=1 node --import tsx scripts/content-edit-check.ts",
    "test:reference": "ASTRO_TELEMETRY_DISABLED=1 node --import tsx scripts/reference-check.ts",
    "content:prepare": "node --import tsx scripts/prepare-cms.ts",
    "predev": "npm run content:prepare",
    "prestart": "npm run content:prepare",
    "precheck": "npm run content:prepare",
    "pretest": "npm run content:prepare",
    "precv": "npm run content:prepare",
    "test:cms": "ASTRO_TELEMETRY_DISABLED=1 node --import tsx scripts/cms-check.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "astro": "^7.4.4",
    "astronomy-engine": "2.1.19",
    "katex": "^0.19.1",
    "lunar-javascript": "1.7.7",
    "pdfkit": "^0.20.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.4",
    "playwright": "^1.56.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "katex": "$katex"
  }
}
