---
import katex from "katex";
import RichText from "../components/RichText.astro";
import { siteContent, plain } from "../data/siteContent";
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import { themes } from "../data/themes";
import { academic, projects } from "../data";
const copy = siteContent.research;
---

<Layout
  title={plain(copy.meta.title)}
  description={plain(copy.meta.description)}
>
  <div class="cream">
    <PageHeading
      eyebrow={copy.heading.eyebrow}
      title={copy.heading.title}
      description={copy.heading.description}
    />
    <div class="container research-list">
      {
        themes.map((theme) => {
          const pubs = academic.publications.filter(
            (p) => !p.placeholder && p.themes.includes(theme.id),
          );
          const related = projects.filter(
            (p) => !p.placeholder && p.themes.includes(theme.id),
          );
          return (
            <section id={theme.id} class="research-theme">
              <>
                <div class="research-text">
                  <>
                    <p class="eyebrow">
                      {theme.number} / <RichText text={theme.subtitle} />
                    </p>
                    <h2>
                      <RichText text={theme.title} />
                    </h2>
                    <p class="lede">
                      <RichText text={theme.description} />
                    </p>
                    <div
                      class="equation"
                      set:html={katex.renderToString(theme.math, {
                        displayMode: true,
                        throwOnError: true,
                        output: "htmlAndMathml",
                      })}
                    />
                    <p class="meta">
                      <RichText text={theme.caption} />
                    </p>
                    <div class="related-work">
                      <h3>
                        <RichText text={copy.relatedHeading} />
                      </h3>
                      {pubs.length || related.length ? (
                        <ul>
                          {pubs.map((p) => (
                            <li>
                              <a href={`/publications/#${p.id}`}>
                                {p.title}{" "}
                                <span class="arrow-icon" aria-hidden="true" />
                              </a>
                            </li>
                          ))}
                          {related.map((p) => (
                            <li>
                              <a href={`/projects/#${p.id}`}>
                                {p.title}{" "}
                                <span class="arrow-icon" aria-hidden="true" />
                              </a>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p class="content-note">
                          <RichText text={copy.relatedEmpty} />
                        </p>
                      )}
                    </div>
                  </>
                </div>
                <figure>
                  <>
                    <img
                      src={theme.image}
                      alt={plain(copy.illustrationAlt, {
                        title: plain(theme.title).toLowerCase(),
                      })}
                      width="900"
                      height="540"
                      loading="lazy"
                    />
                    <figcaption>
                      <RichText text={copy.illustrationCaption} />
                    </figcaption>
                  </>
                </figure>
              </>
            </section>
          );
        })
      }
    </div>
  </div>
</Layout>
