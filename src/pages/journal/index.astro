---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../../components/PageHeading.astro";
import PostCard from "../../components/PostCard.astro";
const posts = (await getCollection("journal", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const categories = [
  "Research Notes",
  "Conferences & Travel",
  "Mathematics",
  "Life & Other Things",
];
---

<Layout
  title="Journal"
  description="Research notes, mathematical questions, and observations from beyond the desk."
  ><div class="cream">
    <PageHeading
      eyebrow="04 / The journal"
      title="Notes from the shoreline"
      description="A place for working thoughts, mathematical detours, and small observations. Some ideas need room to breathe before they become something else."
    /><section class="container page-section" aria-label="Journal articles">
      <div class="filter-bar" data-journal-filters hidden>
        <label
          >Browse by category<select id="journal-category"
            ><option value="all">All currents</option>{
              categories.map((c) => <option value={c}>{c}</option>)
            }</select
          ></label
        ><p role="status" aria-live="polite" data-journal-count></p><a
          class="text-link"
          href="/rss.xml"
          >Subscribe via RSS <span class="arrow-icon" aria-hidden="true"
          ></span></a
        >
      </div><div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div><p data-journal-empty class="empty-state" hidden>
        No articles in this category yet. There is always room for a new
        beginning.
      </p>
    </section>
  </div>
  <script>
    const filters = document.querySelector<HTMLElement>(
      "[data-journal-filters]",
    );
    const select =
      document.querySelector<HTMLSelectElement>("#journal-category");
    if (filters && select) {
      filters.hidden = false;
      const apply = () => {
        let count = 0;
        document
          .querySelectorAll<HTMLElement>("[data-post]")
          .forEach((post) => {
            post.hidden =
              select.value !== "all" && post.dataset.category !== select.value;
            if (!post.hidden) count++;
          });
        document.querySelector("[data-journal-count]")!.textContent =
          `${count} ${count === 1 ? "article" : "articles"}`;
        (document.querySelector("[data-journal-empty]") as HTMLElement).hidden =
          count > 0;
      };
      select.addEventListener("change", apply);
      apply();
    }
  </script></Layout
>
