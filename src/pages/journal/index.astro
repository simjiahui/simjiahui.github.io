---
import { getCollection } from "astro:content";
import RichText from "../../components/RichText.astro";
import { siteContent, plain } from "../../data/siteContent";
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../../components/PageHeading.astro";
import PostCard from "../../components/PostCard.astro";
const posts = (await getCollection("journal", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const categories = siteContent.journal.categories;
const copy = siteContent.journal;
---

<Layout
  title={plain(copy.meta.title)}
  description={plain(copy.meta.description)}
  ><div class="cream">
    <PageHeading
      eyebrow={copy.heading.eyebrow}
      title={copy.heading.title}
      description={copy.heading.description}
    /><section
      class="container page-section"
      aria-label={plain(copy.articlesLabel)}
    >
      <div
        class="filter-bar"
        data-journal-filters
        data-count-one={copy.one}
        data-count-many={copy.many}
        hidden
      >
        <label
          ><RichText text={copy.categoryLabel} /><select id="journal-category"
            ><option value="all"><RichText text={copy.allCategories} /></option
            >{
              categories.map((c) => <option value={c.value}>{c.label}</option>)
            }</select
          ></label
        ><p role="status" aria-live="polite" data-journal-count></p><a
          class="text-link"
          href="/rss.xml"
          ><RichText text={copy.rssLink} />{" "}<span
            class="arrow-icon"
            aria-hidden="true"></span></a
        >
      </div><div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div><p data-journal-empty class="empty-state" hidden>
        <RichText text={copy.empty} />
      </p>
    </section>
  </div>
  <script>
    import { interpolate } from "../../lib/copy";
    const filters = document.querySelector<HTMLElement>(
      "[data-journal-filters]",
    );
    const select =
      document.querySelector<HTMLSelectElement>("#journal-category");
    if (filters && select) {
      filters.hidden = false;
      const apply = () => {
        let count = 0;
        document
          .querySelectorAll<HTMLElement>("[data-post]")
          .forEach((post) => {
            post.hidden =
              select.value !== "all" && post.dataset.category !== select.value;
            if (!post.hidden) count++;
          });
        document.querySelector("[data-journal-count]")!.textContent =
          interpolate(
            count === 1
              ? filters.dataset.countOne!
              : filters.dataset.countMany!,
            { count },
          );
        (document.querySelector("[data-journal-empty]") as HTMLElement).hidden =
          count > 0;
      };
      select.addEventListener("change", apply);
      apply();
    }
  </script></Layout
>
