---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../data";
export async function getStaticPaths() {
  const posts = await getCollection("journal", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props {
  post: CollectionEntry<"journal">;
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description} article>
  <article class="cream article-page">
    <header class="article-heading container">
      <a class="text-link" href="/journal/">← Back to the journal</a><p
        class="eyebrow"
      >
        {post.data.category}
      </p><h1>{post.data.title}</h1><p class="lede">
        {post.data.description}
      </p><div class="article-meta">
        <time datetime={post.data.date.toISOString()}
          >{formatDate(post.data.date)}</time
        >{
          post.data.sample && (
            <span class="sample-label">
              Sample article · not a personal account
            </span>
          )
        }
      </div><ul class="tags" aria-label="Article tags">
        {post.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>{
      post.data.cover && (
        <figure class="article-cover container">
          <img
            src={post.data.cover}
            alt={post.data.coverAlt ?? ""}
            width="900"
            height="540"
          />
        </figure>
      )
    }<div class="prose"><Content /></div><div class="article-end prose">
      <span aria-hidden="true">☾</span><p>Thank you for reading.</p><a
        href="/journal/"
        >More notes from the shoreline <span
          class="arrow-icon"
          aria-hidden="true"></span></a
      >
    </div>
  </article>
</Layout>
