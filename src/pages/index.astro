---
import { getCollection } from "astro:content";
import RichText from "../components/RichText.astro";
import { siteContent } from "../data/siteContent";
import Layout from "../layouts/Layout.astro";
import LunarHero from "../components/LunarHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PublicationItem from "../components/PublicationItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { profile, academic, projects } from "../data";
import { themes } from "../data/themes";
const posts = (await getCollection("journal", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const copy = siteContent.home;
---

<Layout>
  <LunarHero />
  <section id="research" class="section cream research-home">
    <div class="container">
      <SectionHeading
        eyebrow={copy.research.eyebrow}
        title={copy.research.heading}
        href="/research/"
        link={copy.research.link}
      /><div class="theme-grid">
        {
          themes.map((t) => (
            <a href={`/research/#${t.id}`} class="theme-preview">
              <>
                <span class="theme-number">{t.number}</span>
                <h3>
                  <RichText text={t.title} />
                </h3>
                <p>
                  <RichText text={t.subtitle} />
                </p>
                <span class="theme-arrow" aria-hidden="true">
                  <span class="arrow-icon" aria-hidden="true" />
                </span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section cream">
    <div class="container">
      <SectionHeading
        eyebrow={copy.publications.eyebrow}
        title={copy.publications.heading}
        href="/publications/"
        link={copy.publications.link}
      />{
        academic.publications
          .filter((p) => p.featured)
          .map((p) => <PublicationItem publication={p} />)
      }{
        !academic.publications.some((p) => !p.placeholder) && (
          <p class="content-note">
            <RichText text={copy.publications.emptyNote} />
          </p>
        )
      }
    </div>
  </section>
  <section class="section dark">
    <div class="container">
      <SectionHeading
        eyebrow={copy.projects.eyebrow}
        title={copy.projects.heading}
        href="/projects/"
        link={copy.projects.link}
      />{
        projects
          .filter((p) => p.featured)
          .map((p) => <ProjectCard project={p} />)
      }
    </div>
  </section>
  <section class="section cream">
    <div class="container">
      <SectionHeading
        eyebrow={copy.journal.eyebrow}
        title={copy.journal.heading}
        href="/journal/"
        link={copy.journal.link}
      /><div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
  <section class="contact-section cream">
    <div class="container">
      <p class="eyebrow"><RichText text={copy.contact.eyebrow} /></p><h2>
        <RichText text={copy.contact.heading} />
      </h2><p><RichText text={copy.contact.paragraph} /></p>{
        profile.email ? (
          <a class="button button-dark" href={`mailto:${profile.email}`}>
            <RichText text={copy.contact.emailButton} />{" "}
            <span class="arrow-icon" aria-hidden="true" />
          </a>
        ) : (
          <>
            <>
              <a class="button button-dark" href="/about/#contact">
                <RichText text={copy.contact.linksButton} />{" "}
                <span class="arrow-icon" aria-hidden="true" />
              </a>
              <p class="content-note">
                <RichText text={copy.contact.missingEmail} />
              </p>
            </>
          </>
        )
      }
    </div>
  </section>
</Layout>
