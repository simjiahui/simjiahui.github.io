---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import LunarHero from "../components/LunarHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PublicationItem from "../components/PublicationItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { profile, academic, projects } from "../data";
import { themes } from "../data/themes";
const posts = (await getCollection("journal", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Layout>
  <LunarHero />
  <section id="introduction" class="section cream">
    <div class="container intro-grid">
      <div class="intro-side">
        <p class="eyebrow">Hello, from Sendai</p><div class="portrait-frame">
          {
            profile.portrait ? (
              <img
                src={profile.portrait}
                alt={`Portrait of ${profile.name}`}
                width="400"
                height="480"
                loading="lazy"
              />
            ) : (
              <div class="portrait-placeholder">
                <>
                  <span aria-hidden="true">☾</span>
                  <span>
                    Your photograph
                    <br />
                    belongs here
                  </span>
                </>
              </div>
            )
          }
        </div><p class="meta">A person behind the equations.</p>
      </div><div class="intro-copy">
        <h2>Curiosity at the edge<br />of <em>complexity.</em></h2><p
          class="lede"
        >
          {profile.biography}
        </p><p>
          I am interested in how structure shapes dynamics, how systems
          remember, and how patterns can help us understand what comes next.
        </p><p class="content-note">{profile.biographyNote}</p><a
          class="text-link"
          href="/about/"
          >A little more about me <span aria-hidden="true"
            ><span class="arrow-icon" aria-hidden="true"></span></span
          ></a
        >
      </div>
    </div>
  </section>
  <section class="section cream research-home">
    <div class="container">
      <SectionHeading
        eyebrow="01 / Questions that guide me"
        title="Research, in four currents"
        href="/research/"
        link="Explore the research"
      /><div class="theme-grid">
        {
          themes.map((t) => (
            <a href={`/research/#${t.id}`} class="theme-preview">
              <>
                <span class="theme-number">{t.number}</span>
                <h3>{t.title}</h3>
                <p>{t.subtitle}</p>
                <span class="theme-arrow" aria-hidden="true">
                  <span class="arrow-icon" aria-hidden="true" />
                </span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section cream">
    <div class="container">
      <SectionHeading
        eyebrow="02 / Ideas into words"
        title="Selected publications"
        href="/publications/"
        link="All publications & talks"
      />{
        academic.publications
          .filter((p) => p.featured)
          .map((p) => <PublicationItem publication={p} />)
      }{
        !academic.publications.some((p) => !p.placeholder) && (
          <p class="content-note">
            Verified publications will be added here. The sample above
            demonstrates the layout and is excluded from the CV.
          </p>
        )
      }
    </div>
  </section>
  <section class="section dark">
    <div class="container">
      <SectionHeading
        eyebrow="03 / From theory to practice"
        title="Things I am building"
        href="/projects/"
        link="View the project gallery"
      />{
        projects
          .filter((p) => p.featured)
          .map((p) => <ProjectCard project={p} />)
      }
    </div>
  </section>
  <section class="section cream">
    <div class="container">
      <SectionHeading
        eyebrow="04 / Notes from the shoreline"
        title="The journal"
        href="/journal/"
        link="Browse all notes"
      /><div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
  <section class="contact-section cream">
    <div class="container">
      <p class="eyebrow">Good ideas begin with a conversation</p><h2>
        Let’s find a<br /><em>common rhythm.</em>
      </h2><p>For research conversations, questions, or a simple hello.</p>{
        profile.email ? (
          <a class="button button-dark" href={`mailto:${profile.email}`}>
            Get in touch <span class="arrow-icon" aria-hidden="true" />
          </a>
        ) : (
          <>
            <>
              <a class="button button-dark" href="/about/#contact">
                Contact & professional links{" "}
                <span class="arrow-icon" aria-hidden="true" />
              </a>
              <p class="content-note">Email address to be added.</p>
            </>
          </>
        )
      }
    </div>
  </section>
</Layout>
