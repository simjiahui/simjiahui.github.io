---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" noindex
  ><section class="cream not-found container">
    <p class="eyebrow">404 / A little off course</p><span
      class="lost-moon"
      aria-hidden="true">☾</span
    ><h1>This tide leads<br /><em>somewhere else.</em></h1><p>
      The page you are looking for may have moved, or may still be taking shape.
    </p><a class="button button-dark" href="/"
      >Back to the observatory <span class="arrow-icon" aria-hidden="true"
      ></span></a
    ><a class="text-link" href="/journal/"
      >Or wander through the journal <span class="arrow-icon" aria-hidden="true"
      ></span></a
    >
  </section></Layout
>
