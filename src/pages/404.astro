---
import Layout from "../layouts/Layout.astro";
import RichText from "../components/RichText.astro";
import { siteContent, plain } from "../data/siteContent";
const copy = siteContent.notFound;
---

<Layout title={plain(copy.title)} noindex
  ><section class="cream not-found container">
    <p class="eyebrow"><RichText text={copy.eyebrow} /></p><span
      class="lost-moon"
      aria-hidden="true">☾</span
    ><h1><RichText text={copy.heading} /></h1><p>
      <RichText text={copy.description} />
    </p><a class="button button-dark" href="/"
      ><RichText text={copy.homeLink} />{" "}<span
        class="arrow-icon"
        aria-hidden="true"></span></a
    ><a class="text-link" href="/journal/"
      ><RichText text={copy.journalLink} />{" "}<span
        class="arrow-icon"
        aria-hidden="true"></span></a
    >
  </section></Layout
>
