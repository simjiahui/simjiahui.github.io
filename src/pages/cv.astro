---
import Layout from "../layouts/Layout.astro";
import RichText from "../components/RichText.astro";
import { siteContent, plain } from "../data/siteContent";
import PageHeading from "../components/PageHeading.astro";
import { academic, profile } from "../data";
const real = academic.publications.filter((p) => !p.placeholder);
const copy = siteContent.cv;
---

<Layout
  title={plain(copy.meta.title)}
  description={plain(copy.meta.description)}
  ><div class="cream">
    <PageHeading
      eyebrow={copy.heading.eyebrow}
      title={copy.heading.title}
      description={copy.heading.description}
    /><section class="container page-section cv-grid">
      <div>
        <p class="eyebrow">{profile.institution}</p><h2>{profile.name}</h2><p
          class="lede"
        >
          {profile.role}
        </p>{
          profile.nameIsPlaceholder && (
            <p class="sample-label">
              <RichText text={copy.draft} />
            </p>
          )
        }<p>
          <RichText text={copy.description} />
        </p><a class="button button-dark" href="/cv.pdf" download
          ><RichText text={copy.download} />{" "}<span aria-hidden="true"
            ><RichText text={copy.downloadFormat} /></span
          ></a
        ><p class="content-note">
          <RichText text={copy.recordNote} />
        </p>
      </div><aside class="cv-paper" aria-label={plain(copy.contentsLabel)}>
        <span class="eyebrow"><RichText text={copy.paperEyebrow} /></span><h3>
          {profile.name}
        </h3><p>
          {profile.role}<br />{profile.institution}
        </p><hr /><h4><RichText text={copy.interestsHeading} /></h4><p>
          <RichText text={copy.interests} />
        </p><h4><RichText text={copy.recordsHeading} /></h4><p>
          <RichText
            text={copy.educationCount}
            variables={{ count: academic.education.length }}
          /><br /><RichText
            text={copy.experienceCount}
            variables={{ count: academic.experience.length }}
          /><br /><RichText
            text={copy.publicationCount}
            variables={{
              count: real.filter((p) => !["talk", "seminar"].includes(p.type))
                .length,
            }}
          /><br /><RichText
            text={copy.talkCount}
            variables={{
              count: real.filter((p) => ["talk", "seminar"].includes(p.type))
                .length,
            }}
          />
        </p><span class="meta"><RichText text={copy.generatedNote} /></span>
      </aside>
    </section>
  </div></Layout
>
