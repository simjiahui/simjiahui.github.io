---
import Layout from "../layouts/Layout.astro";
import RichText from "../components/RichText.astro";
import { siteContent, plain } from "../data/siteContent";
import PageHeading from "../components/PageHeading.astro";
import { profile, academic } from "../data";
const copy = siteContent.about;
---

<Layout
  title={plain(copy.meta.title)}
  description={plain(copy.meta.description)}
  ><div class="cream">
    <PageHeading
      eyebrow={copy.heading.eyebrow}
      title={copy.heading.title}
      description={copy.heading.description}
    /><section class="container about-grid page-section">
      <div>
        <div class="portrait-frame large">
          {
            profile.portrait ? (
              <img
                src={profile.portrait}
                alt={plain(siteContent.shared.portraitAlt)}
                width="600"
                height="720"
              />
            ) : (
              <div class="portrait-placeholder">
                <>
                  <span aria-hidden="true">☾</span>
                  <span>
                    <RichText text={copy.photoPlaceholder} />
                  </span>
                </>
              </div>
            )
          }
        </div><p class="meta">{profile.location}</p>
      </div><div class="about-copy">
        <p class="eyebrow"><RichText text={copy.greeting} /></p><h2>
          {profile.name}<span class="pink"
            >{siteContent.shared.headingPunctuation}</span
          >
        </h2>{
          profile.nameIsPlaceholder && (
            <p class="sample-label">
              <RichText text={copy.namePlaceholder} />
            </p>
          )
        }<p class="lede"><RichText text={siteContent.shared.biography} /></p><p
          class="content-note"
        >
          <RichText text={siteContent.shared.biographyNote} />
        </p><h3><RichText text={copy.journeyHeading} /></h3><p>
          <RichText text={copy.journeyParagraph} />
        </p><h3><RichText text={copy.educationHeading} /></h3>{
          academic.education.length ? (
            <ul class="timeline">
              {academic.education.map((e) => (
                <li>
                  <span class="meta">
                    {e.start} — {e.end}
                  </span>
                  <h4>{e.title}</h4>
                  <p>{e.institution}</p>
                  <p>{e.description}</p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="content-note">
              <RichText text={copy.educationEmpty} />
            </p>
          )
        }{
          academic.experience.length > 0 && (
            <>
              <>
                <h3>
                  <RichText text={copy.experienceHeading} />
                </h3>
                <ul class="timeline">
                  {academic.experience.map((e) => (
                    <li>
                      <span class="meta">
                        {e.start} — {e.end}
                      </span>
                      <h4>{e.title}</h4>
                      <p>{e.institution}</p>
                      <p>{e.description}</p>
                    </li>
                  ))}
                </ul>
              </>
            </>
          )
        }<h3><RichText text={copy.interestsHeading} /></h3>{
          profile.interests.length ? (
            <ul>
              {profile.interests.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          ) : (
            <p class="content-note">
              <RichText text={copy.interestsEmpty} />
            </p>
          )
        }
      </div>
    </section>
    <section class="section container">
      <div class="section-heading">
        <div>
          <p class="eyebrow"><RichText text={copy.gallery.eyebrow} /></p><h2>
            <RichText text={copy.gallery.heading} />
          </h2>
        </div>
      </div><div class="photo-gallery">
        {
          profile.gallery.map((photo, i) => (
            <figure>
              {photo.src ? (
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width="600"
                  height="750"
                  loading="lazy"
                />
              ) : (
                <div class="photo-placeholder">
                  <span class="eyebrow">
                    <RichText
                      text={copy.gallery.photoNumber}
                      variables={{ number: String(i + 1).padStart(2, "0") }}
                    />
                  </span>
                  <span aria-hidden="true">＋</span>
                  <span>
                    <RichText text={copy.gallery.placeholder} />
                  </span>
                </div>
              )}
              <figcaption>
                {photo.caption}
                {!photo.src && copy.gallery.captionSuffix}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>
    <section id="contact" class="container contact-block">
      <p class="eyebrow"><RichText text={copy.contact.eyebrow} /></p><h2>
        <RichText text={copy.contact.heading} />
      </h2><p>
        <RichText text={copy.contact.paragraph} />
      </p><div class="inline-links">
        {
          profile.links.map((l) => (
            <a href={l.url}>
              {l.label} <span class="arrow-icon" aria-hidden="true" />
            </a>
          ))
        }{
          profile.email && (
            <a href={`mailto:${profile.email}`}>
              <RichText text={siteContent.shared.emailLabel} />{" "}
              <span class="arrow-icon" aria-hidden="true" />
            </a>
          )
        }<a href="/cv.pdf"
          ><RichText text={copy.contact.cvLink} />{" "}<span
            class="arrow-icon"
            aria-hidden="true"></span></a
        >
      </div>{
        !profile.email && (
          <p class="content-note">
            <RichText text={copy.contact.missingEmail} />
          </p>
        )
      }
    </section>
  </div></Layout
>
