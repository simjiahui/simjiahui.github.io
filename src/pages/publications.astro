---
import Layout from "../layouts/Layout.astro";
import RichText from "../components/RichText.astro";
import { siteContent, plain } from "../data/siteContent";
import PageHeading from "../components/PageHeading.astro";
import PublicationItem from "../components/PublicationItem.astro";
import { academic } from "../data";
const publications = [...academic.publications].sort((a, b) =>
  b.date.localeCompare(a.date),
);
const years = [
  ...new Set(
    publications.filter((p) => !p.placeholder).map((p) => p.date.slice(0, 4)),
  ),
]
  .sort()
  .reverse();
const copy = siteContent.publications;
---

<Layout
  title={plain(copy.meta.title)}
  description={plain(copy.meta.description)}
>
  <div class="cream">
    <PageHeading
      eyebrow={copy.heading.eyebrow}
      title={copy.heading.title}
      description={copy.heading.description}
    />
    <section
      class="container page-section"
      aria-label={plain(copy.recordsLabel)}
    >
      <div
        class="filter-bar"
        data-publication-filters
        data-count-one={copy.filters.one}
        data-count-many={copy.filters.many}
        hidden
      >
        <label
          ><RichText text={copy.filters.type} /><select id="publication-type"
            ><option value="all"
              ><RichText text={copy.filters.allTypes} /></option
            ><option value="journal"
              ><RichText text={copy.filters.journal} /></option
            ><option value="conference"
              ><RichText text={copy.filters.conference} /></option
            ><option value="preprint"
              ><RichText text={copy.filters.preprint} /></option
            ><option value="poster"
              ><RichText text={copy.filters.poster} /></option
            ><option value="talk"><RichText text={copy.filters.talk} /></option
            ><option value="seminar"
              ><RichText text={copy.filters.seminar} /></option
            ></select
          ></label
        ><label
          ><RichText text={copy.filters.year} /><select id="publication-year"
            ><option value="all"
              ><RichText text={copy.filters.allYears} /></option
            >{years.map((y) => <option value={y}>{y}</option>)}{
              publications.some((p) => p.placeholder) && (
                <option value="sample">
                  <RichText text={copy.filters.sampleYear} />
                </option>
              )
            }</select
          ></label
        ><p
          class="filter-count"
          role="status"
          aria-live="polite"
          data-publication-count
        >
        </p>
      </div>
      <div>
        {publications.map((p) => <PublicationItem publication={p} />)}
      </div><p class="empty-state" data-publication-empty hidden>
        <RichText text={copy.noMatches} />
      </p>
      {
        !publications.some((p) => !p.placeholder) && (
          <aside class="note-box">
            <>
              <h2>
                <RichText text={copy.emptyHeading} />
              </h2>
              <p>
                <RichText text={copy.emptyParagraph} />
              </p>
            </>
          </aside>
        )
      }
      <p class="content-note">
        <RichText text={copy.cvPrompt} />
        <a href="/cv.pdf"
          ><RichText text={copy.cvLink} />{" "}<span
            class="arrow-icon"
            aria-hidden="true"></span></a
        >
      </p>
    </section>
  </div>
</Layout>
