---
import Layout from "../layouts/Layout.astro";
import RichText from "../components/RichText.astro";
import { siteContent, plain } from "../data/siteContent";
const copy = siteContent.colophon;
import PageHeading from "../components/PageHeading.astro";
---

<Layout
  title={plain(copy.meta.title)}
  description={plain(copy.meta.description)}
  ><div class="cream">
    <PageHeading
      eyebrow={copy.heading.eyebrow}
      title={copy.heading.title}
      description={copy.heading.description}
    /><div class="prose page-section">
      <section id="lunar-scene">
        <h2><RichText text={copy.moonHeading} /></h2><p>
          <RichText text={copy.astronomyParagraph} />
        </p><p><RichText text={copy.moonArtParagraph} /></p><h3>
          <RichText text={copy.motionHeading} />
        </h3><p><RichText text={copy.motionParagraph} /></p><p>
          <RichText text={copy.tideDisclaimer} />
        </p><h3><RichText text={copy.calendarHeading} /></h3><p>
          <RichText text={copy.calendarParagraph} />
        </p><h3><RichText text={copy.accessibilityHeading} /></h3><p>
          <RichText text={copy.accessibilityParagraph} />
        </p>
      </section><h2><RichText text={copy.technologyHeading} /></h2><p>
        <RichText text={copy.technologyParagraph} />
      </p><p><RichText text={copy.cvParagraph} /></p><p>
        <a href="https://github.com/simjiahui/simjiahui.github.io"
          ><RichText text={copy.sourceLink} />{" "}<span
            class="arrow-icon"
            aria-hidden="true"></span></a
        >
      </p>
    </div>
  </div></Layout
>
