---
import { profile } from "../data";
import RichText from "../components/RichText.astro";
import { siteContent, plain } from "../data/siteContent";
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-400-italic.css";
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "@fontsource/dm-sans/latin-600.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  title,
  description = plain(siteContent.shared.siteDescription),
  image = "/images/og.png",
  article = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname === "/404/" ? "/404.html" : Astro.url.pathname,
  Astro.site,
);
const pageTitle = title
  ? `${title} · ${profile.siteTitle}`
  : `${profile.siteTitle} · ${profile.role}`;
const copy = siteContent.shared;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B1424" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={plain(copy.rssAlternateTitle)}
      href="/rss.xml"
    />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:alt" content={plain(copy.socialImageAlt)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main"><RichText text={copy.skipLink} /></a>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="wordmark" href="/" aria-label={plain(copy.homeLabel)}
          >{profile.name}</a
        >
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="primary-nav"
          hidden
          ><RichText text={copy.menu} />{" "}<span aria-hidden="true">＋</span
          ></button
        >
        <nav id="primary-nav" aria-label={plain(copy.navigationLabel)}>
          {
            profile.navigation.map((link) => (
              <a
                href={link.href}
                aria-current={
                  Astro.url.pathname === link.href ? "page" : undefined
                }
                class:list={[{ "nav-cv": link.href === "/cv.pdf" }]}
              >
                {link.label}
                {link.href === "/cv.pdf" && (
                  <span aria-hidden="true">
                    {" "}
                    <span class="arrow-icon" aria-hidden="true" />
                  </span>
                )}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="wordmark" href="/">{profile.name}</a><p>
            <RichText text={copy.footer.description} />
          </p>
        </div>
        <div>
          <p class="eyebrow">
            <RichText text={copy.footer.linksHeading} />
          </p><div class="footer-links">
            {
              profile.links.map((link) => (
                <a href={link.url}>
                  {link.label} <span class="arrow-icon" aria-hidden="true" />
                </a>
              ))
            }{
              profile.email && (
                <a href={`mailto:${profile.email}`}>
                  <RichText text={copy.emailLabel} />{" "}
                  <span class="arrow-icon" aria-hidden="true" />
                </a>
              )
            }<a href="/cv.pdf"
              ><RichText text={copy.cvLabel} />{" "}<span
                class="arrow-icon"
                aria-hidden="true"></span></a
            >
          </div>
        </div>
      </div>
      <div class="container footer-bottom">
        <span
          >© {new Date().getUTCFullYear()}{" "}
          {profile.nameIsPlaceholder ? profile.siteTitle : profile.name}</span
        ><span><RichText text={copy.footer.privacy} /></span><a
          href="/colophon/"
          ><RichText text={copy.footer.colophonLink} />{" "}<span
            class="arrow-icon"
            aria-hidden="true"></span></a
        >
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#primary-nav");
      if (button && nav) {
        button.hidden = false;
        document.documentElement.classList.add("has-menu");
        const close = () => {
          button.setAttribute("aria-expanded", "false");
          nav.classList.remove("is-open");
        };
        button.addEventListener("click", () => {
          const open = button.getAttribute("aria-expanded") !== "true";
          button.setAttribute("aria-expanded", String(open));
          nav.classList.toggle("is-open", open);
        });
        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            button.getAttribute("aria-expanded") === "true"
          ) {
            close();
            button.focus();
          }
        });
        nav
          .querySelectorAll("a")
          .forEach((link) => link.addEventListener("click", close));
      }
    </script>
  </body>
</html>
