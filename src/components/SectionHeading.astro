---
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  link?: string;
}
const { eyebrow, title, href, link = "Explore more" } = Astro.props;
---

<div class="section-heading">
  <div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2></div>{
    href && (
      <a class="text-link" href={href}>
        {link}{" "}
        <span aria-hidden="true">
          <span class="arrow-icon" aria-hidden="true" />
        </span>
      </a>
    )
  }
</div>
