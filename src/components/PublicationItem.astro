---
import type { Publication } from "../data/schema";
import RichText from "../components/RichText.astro";
import { siteContent } from "../data/siteContent";
import { profile, formatDate } from "../data";
interface Props {
  publication: Publication;
}
const { publication: p } = Astro.props;
const copy = siteContent.publications.card;
const links = [
  { label: copy.doi, url: p.doi ? `https://doi.org/${p.doi}` : "" },
  { label: copy.arxiv, url: p.arxiv ? `https://arxiv.org/abs/${p.arxiv}` : "" },
  { label: copy.pdf, url: p.pdf },
  { label: copy.code, url: p.code },
  { label: copy.slides, url: p.slides },
].filter((l) => l.url);
---

<article
  class="publication-item"
  id={p.id}
  data-publication
  data-citation-messages
  data-copied={copy.copied}
  data-copy-failed={copy.copyFailed}
  data-type={p.type}
  data-year={p.placeholder ? "sample" : p.date.slice(0, 4)}
>
  <div class="publication-date">
    <span>{p.placeholder ? copy.sampleYear : p.date.slice(0, 4)}</span><span
      class="type-label">{copy.types[p.type]}</span
    >
  </div>
  <div class="publication-body">
    {
      p.placeholder && (
        <span class="sample-label">
          <RichText text={copy.placeholder} />
        </span>
      )
    }
    <h3>{p.title}</h3>
    <p class="authors">
      {
        p.authors.map((author, index) => (
          <>
            {index > 0 && ", "}
            {author === profile.name ? <strong>{author}</strong> : author}
          </>
        ))
      }
    </p>
    <p class="publication-venue">
      {p.venue} · {p.status}{
        !p.placeholder && (
          <>
            {" "}
            · <time datetime={p.date}>{formatDate(p.date)}</time>
          </>
        )
      }
    </p>
    {
      links.length > 0 && (
        <div class="inline-links">
          {links.map((l) => (
            <a href={l.url}>
              {l.label} <span class="arrow-icon" aria-hidden="true" />
            </a>
          ))}
        </div>
      )
    }
    {
      p.bibtex && !p.placeholder && (
        <details
          class="bibtex"
          data-copied={copy.copied}
          data-copy-failed={copy.copyFailed}
        >
          <>
            <summary>
              <RichText text={copy.bibtexSummary} />
            </summary>
            <pre>
              <code>{p.bibtex}</code>
            </pre>
            <button data-copy={p.bibtex} class="small-button">
              <RichText text={copy.copy} />
            </button>
            <button
              data-download={p.bibtex}
              data-filename={`${p.id}.bib`}
              class="small-button"
            >
              <RichText text={copy.download} />
            </button>
            <span class="copy-status" role="status" />
          </>
        </details>
      )
    }
  </div>
</article>

<script src="../scripts/publications.ts"></script>
