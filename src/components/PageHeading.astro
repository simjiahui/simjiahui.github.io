---
import RichText from "../components/RichText.astro";
import { siteContent } from "../data/siteContent";
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="page-heading container">
  <p class="eyebrow"><RichText text={eyebrow} /></p><h1>
    <RichText text={title} /><span class="pink"
      >{siteContent.shared.headingPunctuation}</span
    >
  </h1><p class="lede">
    <RichText text={description} />
  </p>
</div>
