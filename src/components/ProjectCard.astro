---
import type { projects as projectData } from "../data";
import RichText from "../components/RichText.astro";
import { siteContent, plain } from "../data/siteContent";
import { academic } from "../data";
import { repositoryMetadata } from "../lib/github";
interface Props {
  project: (typeof projectData)[number];
}
const { project: p } = Astro.props;
const metadata = p.repository ? await repositoryMetadata(p.repository) : null;
const publication = academic.publications.find(
  (pub) => pub.id === p.publication,
);
const copy = siteContent.projects.card;
---

<article class="project-card">
  <div class="project-art">
    {
      p.image && (
        <img
          src={p.image}
          alt={plain(copy.imageAlt, { title: p.title })}
          width="900"
          height="540"
          loading="lazy"
          decoding="async"
        />
      )
    }{
      p.placeholder && (
        <span class="art-label">
          <RichText text={copy.sample} />
        </span>
      )
    }
  </div>
  <div class="project-copy">
    <p class="eyebrow">
      <RichText text={p.placeholder ? copy.sampleEyebrow : copy.eyebrow} />
    </p><h3>{p.title}</h3><p>{p.description}</p><ul
      class="tags"
      aria-label={plain(copy.technologiesLabel)}
    >
      {p.technologies.map((t) => <li>{t}</li>)}
    </ul><div class="inline-links">
      {
        p.repository && (
          <a href={p.repository}>
            <RichText text={copy.repository} />{" "}
            <span class="arrow-icon" aria-hidden="true" />
          </a>
        )
      }{
        p.demo && (
          <a href={p.demo}>
            <RichText text={copy.demo} />{" "}
            <span class="arrow-icon" aria-hidden="true" />
          </a>
        )
      }{
        publication && (
          <a href={`/publications/#${publication.id}`}>
            <RichText text={copy.publication} />{" "}
            <span class="arrow-icon" aria-hidden="true" />
          </a>
        )
      }
    </div>{
      metadata && (
        <p class="meta">
          {metadata.language ?? copy.publicRepository} ·{" "}
          <RichText text={copy.stars} variables={{ count: metadata.stars }} />
        </p>
      )
    }
  </div>
</article>
