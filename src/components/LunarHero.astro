---
import { profile } from "../data";
import RichText from "../components/RichText.astro";
import { siteContent, text } from "../data/siteContent";
import { moonState } from "../lib/astronomy";
import { staticScene } from "../lib/ascii";
const state = moonState();
const calendarTime = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "Asia/Shanghai",
}).format(new Date(state.date));
const copy = siteContent.hero;
---

<section class="lunar-hero" aria-labelledby="hero-title">
  <div class="lunar-scene" aria-hidden="true">
    <pre
      data-ascii-fallback
      class="fallback-desktop">{staticScene(state.angle, false, state.fraction, state.forcing)}</pre>
    <pre
      data-ascii-fallback
      class="fallback-mobile">{staticScene(state.angle, true, state.fraction, state.forcing)}</pre><canvas
      data-lunar-canvas
      data-state={JSON.stringify(state)}></canvas><div class="scene-shade">
    </div>
  </div>
  <div class="hero-inner container">
    <div class="hero-topline">
      <span class="eyebrow"><RichText text={copy.eyebrow} /></span><span
        class="hero-coordinate"><RichText text={copy.coordinates} /></span
      >
    </div>
    <div class="hero-copy">
      <p class="eyebrow hero-role">
        <RichText text={copy.roleLine} />
      </p>
      {
        profile.nameIsPlaceholder && (
          <span class="name-placeholder">
            <RichText text={copy.namePlaceholder} />
          </span>
        )
      }
      <h1 id="hero-title">
        {profile.name}<span class="pink"
          >{siteContent.shared.headingPunctuation}</span
        >
      </h1>
      <p class="hero-subtitle">
        <RichText text={copy.subtitle} />
      </p>
      <p class="hero-description">
        <RichText text={copy.description} />
      </p>
      <div class="hero-actions">
        <a class="button button-pink" href="/research/"
          ><RichText text={copy.researchButton} />{" "}<span aria-hidden="true"
            ><span class="arrow-icon" aria-hidden="true"></span></span
          ></a
        ><a class="subtle-link" href="/publications/"
          ><RichText text={copy.publicationsButton} />{" "}<span
            class="arrow-icon"
            aria-hidden="true"></span></a
        ><a class="subtle-link" href="/cv.pdf"
          ><RichText text={copy.cvButton} />{" "}<span
            class="arrow-icon"
            aria-hidden="true"></span></a
        >
      </div>
    </div>
    <div class="hero-bottom">
      <a class="scroll-cue" href="#introduction"
        ><span aria-hidden="true">↓</span> <RichText text={copy.scrollCue} /></a
      ><div class="moon-readout">
        <span class="readout-dot" aria-hidden="true"></span><span data-phase
          >{state.phase}</span
        ><span class="readout-divider">/</span><span
          data-illumination
          data-template={copy.illumination}
          >{
            text(copy.illumination, {
              percent: Math.round(state.fraction * 100),
            })
          }</span
        ><span class="lunar-date" data-lunar-date lang="zh"
          >{state.calendar.label}</span
        >
      </div>
    </div>
  </div>
</section>
<div class="observation-bar">
  <div class="container observation-inner">
    <p>
      <span class="eyebrow"><RichText text={copy.observation.eyebrow} /></span
      ><span data-festival data-fallback={copy.observation.festivalFallback}
        >{state.calendar.festival ?? copy.observation.festivalFallback}</span
      >
    </p><a href="/colophon/#lunar-scene"
      ><RichText text={copy.observation.explanationLink} />{" "}<span
        aria-hidden="true"
        ><span class="arrow-icon" aria-hidden="true"></span></span
      ></a
    >
  </div>
</div>
<details class="observation-details container">
  <summary><RichText text={copy.observation.summary} /></summary><p>
    <RichText text={copy.observation.reference} />{" "}<span
      data-moon-position
      data-template={copy.observation.position}
      ><RichText
        text={copy.observation.position}
        variables={{
          altitude: state.altitude.toFixed(1),
          azimuth: state.azimuth.toFixed(1),
        }}
      /></span
    ><RichText text={copy.observation.calendar} />{" "}<span
      data-observation-time>{calendarTime}</span
    >
    <RichText text={copy.observation.snapshot} />
  </p><p>
    <RichText text={copy.observation.artisticNote} />
  </p>
</details>
<script src="../scripts/lunar-scene.ts"></script>
